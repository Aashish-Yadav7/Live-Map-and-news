# ── Frontend (Vite) ──────────────────────────────────────────────
# Supabase project URL and anon key — both are safe for client-side use
# when Row Level Security is enabled on all tables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Edge Function secrets (set via Supabase dashboard → Edge Functions → Secrets)
# These are optional. The app falls back to free RSS feeds if not set.
GNEWS_API_KEY=your-gnews-api-key
GUARDIAN_API_KEY=your-guardian-api-key
